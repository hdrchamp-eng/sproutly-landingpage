# Canonical HTTPS URL; leave empty for local development (indexing disabled).
NEXT_PUBLIC_SITE_URL=
# Separate landingpage project ONLY. Public credentials, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: public submission RPC, aggregation, retention. Never browser-exposed.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ character secret for privacy-preserving rate-limit identifiers.
RATE_LIMIT_SECRET=
# Trusted ingress must overwrite x-forwarded-for; Vercel does this.
TRUST_PROXY=false
# Optional scheduled retention endpoint bearer credential, minimum 32 characters.
CRON_SECRET=
# Optional latest-post integration; all server-only. Leave empty for manual mode.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Supported Graph API version from your approved Meta app, e.g. vNN.N.
META_API_VERSION=
